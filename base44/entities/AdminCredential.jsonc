{
  "name": "AdminCredential",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "staff"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "default": "owner"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_used_ms": {
      "type": "number"
    },
    "code_hash": {
      "type": "string"
    },
    "salt": {
      "type": "string"
    },
    "iterations": {
      "type": "number"
    },
    "rotated_at_ms": {
      "type": "number"
    },
    "deployment_id": {
      "type": "string"
    }
  },
  "required": [
    "code_hash",
    "salt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}